{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "command": "g++",
            "args": [
                "-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-g",
                "${file}",
                "-o", "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "type": "shell",
            "label": "C/C++: g++ build all .cpp in folder",
            "command": "g++ -std=c++20 -Wall -Wextra -Wpedantic -g (Get-ChildItem -Path '${fileDirname}' -Filter *.cpp).FullName -o '${fileDirname}\\main.exe'",
            "problemMatcher": ["$gcc"]
        }
    ]
}